@@ -83,6 +83,53 @@
 
 #define INIT_FUNC	"dl_load"
 
+#ifdef GAWK_STATIC_EXTENSIONS
+/* static-ext.h, written by the build: GAWK_STATIC_EXT("name", token) */
+#define GAWK_STATIC_EXT(name, token) \
+	extern int gawk_static_ext_##token(const gawk_api_t *const, awk_ext_id_t);
+#include "static-ext.h"
+#undef GAWK_STATIC_EXT
+
+static struct static_ext {
+	const char *name;
+	int (*load)(const gawk_api_t *const, awk_ext_id_t);
+	bool loaded;
+} static_exts[] = {
+#define GAWK_STATIC_EXT(name, token) { name, gawk_static_ext_##token, false },
+#include "static-ext.h"
+#undef GAWK_STATIC_EXT
+};
+
+/* static_ext_find --- built-in extension by @load name, with or without suffix */
+
+static struct static_ext *
+static_ext_find(const char *name)
+{
+	size_t i, n = strlen(name);
+	size_t sl = strlen("." SHLIBEXT);
+
+	if (n > sl && strcmp(name + n - sl, "." SHLIBEXT) == 0)
+		n -= sl;
+	for (i = 0; i < sizeof(static_exts) / sizeof(static_exts[0]); i++)
+		if (strlen(static_exts[i].name) == n
+		    && strncmp(static_exts[i].name, name, n) == 0)
+			return & static_exts[i];
+	return NULL;
+}
+
+bool
+static_ext_known(const char *name)
+{
+	return static_ext_find(name) != NULL;
+}
+#else
+bool
+static_ext_known(const char *name)
+{
+	return false;
+}
+#endif
