Link gawk's C extensions into the binary.

With GAWK_STATIC_EXTENSIONS each extension's dl_load gets its own name
(gawk_static_ext_<module>), the build lists them in static-ext.h and
links their objects through GAWK_STATIC_EXT_OBJS, and @load / -l find them
in a built-in table before searching AWKLIBPATH or calling dlopen.

--- a/Makefile.am
+++ b/Makefile.am
@@ -116,6 +116,9 @@
 	$(LIBSIGSEGV) $(LIBINTL) $(SOCKET_LIBS) $(LIBREADLINE) $(LIBMPFR) \
 	$(LDFLAGS)
 
+# Extensions linked into gawk (GAWK_STATIC_EXTENSIONS); set by the build.
+gawk_LDADD = $(LDADD) $(GAWK_STATIC_EXT_OBJS)
+
 # Directory for gawk's data files. Automake supplies datadir.
 pkgdatadir = $(datadir)/awk
 
