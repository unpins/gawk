--- a/posix/gawkmisc.c
+++ b/posix/gawkmisc.c
@@ -304,11 +304,17 @@
 
 /* files_are_same --- return true if files are identical */
 
+extern int unpin_vfs_is_virtual(const char *path);
+
 int
 files_are_same(char *path, SRCFILE *src)
 {
 	struct stat st;
 
+	/* embedded files all stat with inode 0: the name is the identity */
+	if (unpin_vfs_is_virtual(path) || unpin_vfs_is_virtual(src->fullpath))
+		return strcmp(path, src->fullpath) == 0;
+
 	return (stat(path, & st) == 0
 		&& st.st_dev == src->sbuf.st_dev
 		&& st.st_ino == src->sbuf.st_ino);
